---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import Btn from "./Btn.astro";
import logo from "../assets/logo.png";
import { NAV, CONSULTANT_NAV, CONSULTANT_PATHS, LOGIN, FORM, to, isExternal } from "../lib/site";
const { path } = Astro.props as { path: string };
// A link to a section of a page (#...) is not the page itself, so it never shows as current.
const current = (href: string) => !href.includes("#") && href === path;
// Each audience gets its own menu; a slim bar above the header switches between the two audiences.
const consultant = CONSULTANT_PATHS.includes(path);
const nav = consultant ? CONSULTANT_NAV : NAV;
const audiences = [
  { label: "YECC for SIs", href: "/", on: !consultant },
  { label: "YECC for Oracle Consultants", href: "/consultants", on: consultant },
];
---
<div class="topbar">
  <div class="wrap">
    <nav class="switch" aria-label="Audience">
      {audiences.map((a) => <a href={to(a.href)} class:list={{ on: a.on }} aria-current={a.on ? "true" : undefined}>{a.label}</a>)}
    </nav>
  </div>
</div>
<header class="header">
  <div class="wrap">
    <a class="logo" href={to("/")} aria-label="YourERPCoach.com home">
      <Image src={logo} alt="YourERPCoach.Com" width={434} loading="eager" />
    </a>
    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false">
      <span class="bars"><Icon name="menu" /></span>
      <span class="x"><Icon name="close" /></span>
    </button>
    <div class="header-panel">
      <nav class="nav" aria-label="Main">
        {nav.map((item) =>
          item.children ? (
            <div class="nav-item">
              <button type="button" aria-expanded="false" class:list={{ current: item.children.some((c) => current(c.href)) }}>
                {item.label}<Icon name="chevron" />
              </button>
              <div class="dropdown">
                {/* A child that starts a new group gets a small label above it. */}
                {item.children.map((c, i) => <>
                  {c.group && c.group !== item.children![i - 1]?.group && <span class="dropdown-label">{c.group}</span>}
                  <a href={to(c.href)}>{c.label}</a>
                </>)}
              </div>
            </div>
          ) : (
            <a href={to(item.href)} class:list={{ current: current(item.href) }} aria-current={current(item.href) ? "page" : undefined} {...(isExternal(item.href) ? { target: "_blank", rel: "noopener" } : {})}>{item.label}</a>
          )
        )}
      </nav>
      <div class="header-cta">
        {/* SIs are sent to the discussion form; consultants sign in to their courses. */}
        {consultant ? <Btn href={LOGIN}>Sign in</Btn> : <Btn href={FORM}>Explore Partnership</Btn>}
      </div>
    </div>
  </div>
</header>
