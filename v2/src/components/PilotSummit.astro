---
// Illustration for the SHERPA pilot: a trail up a mountain, past checkpoints 01 to 03 (the three pilot
// inclusions), to a flag at the summit. Drawn in logo colours so it sits on the navy section.
const stops = [
  { x: 150, y: 352, n: "01" },
  { x: 318, y: 262, n: "02" },
  { x: 268, y: 176, n: "03" },
];
---
<svg class="pilot-summit" viewBox="0 0 520 440" fill="none" aria-hidden="true">
  <circle cx="270" cy="230" r="200" fill="#2b72d9" opacity=".12" />
  <path d="M10 410 L150 235 L250 410 Z" fill="#2b72d9" opacity=".35" />
  <path d="M310 410 L430 215 L510 410 Z" fill="#2b72d9" opacity=".3" />
  <path d="M40 410 L300 92 L480 410 Z" fill="#2b72d9" />
  <path d="M300 92 L480 410 L380 410 Z" fill="#1f5ab3" />
  <path d="M300 92 L255 147 L276 140 L292 158 L312 138 L330 150 L345 145 Z" fill="#e8f0fc" />
  <path d="M150 352 C 230 330, 300 300, 318 262 S 250 210, 268 176 S 300 120, 300 98" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9" opacity=".85" />
  <line x1="300" y1="96" x2="300" y2="30" stroke="#e8f0fc" stroke-width="4" stroke-linecap="round" />
  <path d="M302 32 L352 46 L302 60 Z" fill="#e53935" />
  {stops.map((s) => (
    <g>
      <circle cx={s.x} cy={s.y} r="21" fill="#ffffff" />
      <circle cx={s.x} cy={s.y} r="21" stroke="#e53935" stroke-width="3" />
      <text x={s.x} y={s.y + 6} text-anchor="middle" class="pilot-summit-num">{s.n}</text>
    </g>
  ))}
  <g fill="#ffffff">
    <ellipse cx="80" cy="404" rx="66" ry="18" />
    <ellipse cx="140" cy="410" rx="60" ry="16" />
    <ellipse cx="395" cy="408" rx="78" ry="18" />
    <ellipse cx="462" cy="403" rx="48" ry="14" />
    <ellipse cx="260" cy="414" rx="120" ry="14" />
  </g>
</svg>
