---
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Checks from "../components/Checks.astro";
import Col from "../components/Col.astro";
import Card from "../components/Card.astro";
import SherpaPhases from "../components/SherpaPhases.astro";
import PilotSummit from "../components/PilotSummit.astro";
import Cta from "../components/Cta.astro";
import Video from "../components/Video.astro";
import { contact } from "../lib/contact";

// The three steps SHERPA covers, each with what YECC produces or runs at that step.
const flow = [
  {
    id: "author", step: "Author", title: "Capture configured processes",
    bullets: [
      "**User guides:** role-based guidance built around configured business processes",
      "**Process videos:** visual walkthroughs users can revisit at the point of need",
      "The steps, roles and client-specific context behind each process",
    ],
  },
  {
    id: "deliver", step: "Deliver", title: "Assign learning through SHERPA",
    bullets: [
      "**Training delivery:** structured key-user and end-user training aligned with the approved content",
      "**User portal:** a role-based destination for assigned learning and reference materials",
      "Quizzes, completion tracking and reports for each role",
    ],
  },
  {
    id: "maintain", step: "Maintain", title: "Keep learning content current",
    bullets: [
      "Guides and videos updated for quarterly Oracle releases",
      "A review and sign-off trail for every change",
      "Users always see the current version, long after go-live",
    ],
  },
];

// What the complimentary executive pilot includes.
const pilot = [
  {
    title: "Free transformation of up to 25 self-service processes",
    text: "Convert your client’s existing static SOPs, PDFs and user manuals into modern training assets (videos, interactive web guides and in-app walkthroughs), covering up to 25 high-usage employee self-service flows at no cost.",
  },
  {
    title: "Redwood-ready documentation and guidance",
    text: "Rebuild learning assets to reflect Oracle’s latest Redwood UX, so users are guided correctly on redesigned pages, new navigation patterns and changed interaction models.",
  },
  {
    title: "Multi-format, in-app delivery for immediate adoption",
    text: "Deliver the transformed documentation directly where work happens, as videos, web-based guides and contextual in-app guidance, reducing dependency on HR and IT support teams from day one.",
  },
];
---
<Layout
  path="/sherpa"
  title="SHERPA Authoring & Delivery Platform | YECC"
  description="Create, govern, and deliver Oracle user manuals, process videos, and role-based learning through SHERPA."
>
  <Hero
    eyebrow="The authoring and delivery layer"
    title="Create once. Govern centrally.| Deliver learning by role."
    lead="SHERPA is YECC's IP platform for creating user guides, process videos, and in-app learning, delivering role-based end user training, and keeping enablement available beyond go-live."
  >
    <Btn href="#pilot" arrow>Discuss a SHERPA pilot</Btn>
    <Video slot="media" />
  </Hero>

  <Section id="delivery-approach">
    <Head
      eyebrow="Our SHERPA delivery approach"
      title="Built around| your client’s Oracle solution."
      lead="YECC works alongside your implementation and support teams to deliver user-training workshops and training materials specific to your client’s processes, configuration, and users."
    />
    <div class="cols c3">
      <Col num="01" title="We understand the solution" text="We analyse your deliverables (during implementation) or your client’s existing user manuals (during support), as well as your client’s Oracle Cloud test environment." />
      <Col num="02" title="We create and iterate the content" text="Using your client’s data, business processes, and Oracle Cloud test environment, YECC develops customised training guides, videos, interactive videos, and in-app learning content." />
      <Col num="03" title="We deliver through a dedicated portal" text="Personalised Oracle Cloud ERP training materials, combined with custom-prepared quizzes, are bundled into role-specific courses that can be assigned to your client’s end users, and monitored and reported for completion." />
    </div>
  </Section>

  <Section id="benefits" class="bg-navy">
    <Head
      eyebrow="SHERPA benefits"
      title="What SHERPA helps| teams achieve."
      lead="SHERPA turns process-aligned authoring and role-based delivery into stronger user capability, smoother programs, measurable business value, and sustained readiness."
    />
    <div class="cols c4">
      <Col icon="users" title="Capability" bullets={["Better Oracle Cloud process understanding", "More confident end users, in the processes their roles need them to perform"]} />
      <Col icon="target" title="Program success" bullets={["Better design decisions", "Higher-quality SIT and UAT", "Fewer defects and less rework", "Faster decision-making"]} />
      <Col icon="trend" title="Business value" bullets={["Faster user adoption", "Reduced support need for repetitive ‘how to’ queries", "Improved productivity"]} />
      <Col icon="shield" title="Strategic impact" bullets={["Lower transformation risk", "A sustainable operating model", "Release readiness"]} />
    </div>
    <p class="note">Powered by SHERPA as the authoring and delivery system.</p>
  </Section>

  <Section id="how-it-works" class="bg-tint">
    <Head
      eyebrow="How SHERPA works"
      title="Author → Deliver → Maintain"
      lead="Turn configured process knowledge into practical learning assets, role-based delivery, and continuously updated guidance, all through one connected system."
    />
    <ol class="stages c3">
      {flow.map((f, i) => (
        <li id={f.id}>
          <h3><span>{String(i + 1).padStart(2, "0")}</span>{f.step}</h3>
          <p class="stage-title">{f.title}</p>
          <Checks items={f.bullets} />
        </li>
      ))}
    </ol>
  </Section>

  <Section id="authoring">
    <Head
      eyebrow="Author"
      title="Turn configured processes| into governed user knowledge."
      lead="SHERPA helps automatically capture your client’s Oracle instance screens through a browser extension, write contextual navigational instructions and business explanations for every step using YECC’s purpose-built AI agents, and transform this same authored content into multiple delivery formats."
    />
    <div class="grid c4">
      <Card icon="file" title="User guides" text="Step-by-step text guides that can be embedded anywhere, or downloaded as Word Docs, PDFs or SCORM packages." />
      <Card icon="video" title="Process videos" text="Natural-sounding visual walkthroughs, in your chosen language, voice and accent." />
      <Card icon="target" title="Interactive simulations" text="Click-through videos that let users practise the system processes before going to their Oracle Cloud instance." />
      <Card icon="monitor" title="In-app learning" text="SHERPA User Extension sits on top of your client’s Oracle Cloud instance, and guides users while they do the processes." />
    </div>
  </Section>

  <Section>
    <Head
      eyebrow="One connected enablement system"
      title="SHERPA sits at the centre| of every YECC engagement."
      lead="Whether the engagement begins during implementation or AMS, the same governed manuals, process videos, learning paths, and portal access move from creation to delivery and remain current after go-live."
    />
    <SherpaPhases />
  </Section>

  <Section id="pilot" class="bg-navy">
    <div class="split-illo pilot">
      <div>
        <Head
          eyebrow="Complimentary executive pilot"
          title="See the value first,| with no financial commitment."
          lead="YECC offers an executive pilot focused on Oracle Fusion self-service adoption, the area with the highest user volume and support demand."
        />
        <ol class="pilot-list">
          {pilot.map((item, i) => (
            <li>
              <span class="pilot-num">{String(i + 1).padStart(2, "0")}</span>
              <div><h3>{item.title}</h3><p>{item.text}</p></div>
            </li>
          ))}
        </ol>
        <div class="btns"><Btn href={contact("sherpa")} arrow>Discuss a SHERPA pilot</Btn></div>
      </div>
      <PilotSummit />
    </div>
  </Section>

  <Cta eyebrow="See SHERPA in action" title="See how SHERPA can power your user enablement.">
    <Btn href={contact("sherpa")} arrow>Discuss a SHERPA pilot</Btn>
  </Cta>
</Layout>
