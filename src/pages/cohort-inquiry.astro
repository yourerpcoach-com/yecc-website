---
import Layout from "../layouts/Layout.astro";
import Tone from "../components/Tone.astro";
import Icon from "../components/Icon.astro";
import Checks from "../components/Checks.astro";
import { to } from "../lib/site";
import { GOOGLE_FORM_ACTION, ENTRY, COHORT_OPTIONS, SOURCE_OPTIONS } from "../lib/cohort-form";

// Cohort inquiry: the "YECC Fresher Trainings - Leads" Google Form, built into the site.
// ?cohort=oracle-hcm (or oracle-financials, oracle-scm) pre-selects the cohort the visitor came from.
---
<Layout
  path="/cohort-inquiry"
  title="Send an Inquiry for a Fresher Training Cohort | YECC"
  description="Send an inquiry for YECC's Oracle Cloud Financials, Supply Chain Management or Human Capital Management fresher training cohorts. Our team will connect with you."
>
  <section class="hero inquiry-hero" id="inquiry-form">
    <div class="wrap">
      <div class="inquiry-grid">
        <div class="inquiry-intro">
          <p class="eyebrow">Fresher training cohorts</p>
          <h1><Tone text="Send an inquiry.| Our team will connect with you." /></h1>
          <p class="lead">Mark your interest in YECC’s fresher training cohorts for Oracle Cloud Financials, Supply Chain Management or Human Capital Management.</p>
          <Checks items={[
            "Pick the cohort you are interested in",
            "Tell us how to reach you",
            "Our team gets in touch with the next steps",
          ]} />
          <p class="inquiry-links">Not sure yet? Read the cohort details first:</p>
          <ul class="inquiry-cohorts">
            {COHORT_OPTIONS.map((c) => <li><a href={to(`/upcoming-cohorts/${c.slug}`)}>{c.label.replace(" cohort", "")}<Icon name="arrow" /></a></li>)}
          </ul>
        </div>

        <div class="contact-panel">
          <form class="form inquiry" data-inquiry action={GOOGLE_FORM_ACTION} method="post" data-home={to("/consultants")}>
            <fieldset>
              <div class="row">
                <label><span>First name <span class="req" aria-hidden="true">*</span></span><input type="text" name={ENTRY.firstName} autocomplete="given-name" required /></label>
                <label><span>Last name <span class="req" aria-hidden="true">*</span></span><input type="text" name={ENTRY.lastName} autocomplete="family-name" required /></label>
              </div>
              <div class="row">
                <label><span>Country <span class="req" aria-hidden="true">*</span></span><input type="text" name={ENTRY.country} autocomplete="country-name" required /></label>
                <label><span>City <span class="req" aria-hidden="true">*</span></span><input type="text" name={ENTRY.city} autocomplete="address-level2" required /></label>
              </div>
              <div class="row">
                <label><span>Email ID <span class="req" aria-hidden="true">*</span></span><input type="email" name={ENTRY.email} autocomplete="email" required /></label>
                {/* Country code (defaults to +91, editable) and a digits-only number. They are joined into the
                    one Google Form answer, e.g. "+91 9876543210", just before sending. */}
                <div class="field">
                  <label for="wa-number"><span>WhatsApp mobile number <span class="req" aria-hidden="true">*</span></span></label>
                  <div class="phone">
                    <input class="phone-code" type="text" value="+91" aria-label="Country code" inputmode="tel" maxlength="5" pattern="\+[0-9]{1,4}" title="Country code, for example +91" required />
                    <input class="phone-number" id="wa-number" type="tel" inputmode="numeric" autocomplete="tel-national" pattern="[0-9]{6,14}" maxlength="14" placeholder="9876543210" required />
                  </div>
                  <input type="hidden" name={ENTRY.whatsapp} />
                </div>
              </div>
            </fieldset>

            <div class="row">
              <label><span>I am interested to join <span class="req" aria-hidden="true">*</span></span>
                <span class="select">
                  <select name={ENTRY.cohort} required>
                    <option value="" disabled selected>Choose a cohort</option>
                    {COHORT_OPTIONS.map((c) => <option value={c.label} data-cohort={c.slug}>{c.short}</option>)}
                  </select>
                  <Icon name="chevron" />
                </span>
              </label>
              <label><span>How did you come to know about us? <span class="req" aria-hidden="true">*</span></span>
                <span class="select">
                  <select class="source" name={ENTRY.source} required>
                    <option value="" disabled selected>Choose one</option>
                    {SOURCE_OPTIONS.map((o) => <option value={o}>{o.replace(" (mention their name in the answer to next question)", "")}</option>)}
                  </select>
                  <Icon name="chevron" />
                </span>
              </label>
            </div>
            <label class="referred" hidden>I was referred by (full name)<input type="text" name={ENTRY.referredBy} autocomplete="off" /></label>
            {/* The Google Form requires "I have already gone through and understood the details of the cohort".
                The question is no longer shown here, so its answer is always sent. */}
            <input type="hidden" name={ENTRY.understood} value="Yes" />



            <p class="form-error" role="alert" hidden></p>
            <button class="btn" type="submit">Send Inquiry</button>
          </form>

          <div class="form-done" role="status" tabindex="-1" hidden>
            <span class="form-done-icon"><Icon name="check" /></span>
            <h2 data-done-title>Thank you. Your inquiry is on its way.</h2>
            <p data-done-text>Our team will connect with you shortly.</p>
            <p class="form-done-redirect">Taking you back in <b data-countdown>8</b> seconds. <a href={to("/consultants")}>Go now</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
