---
import Layout from "../layouts/Layout.astro";
import Btn from "../components/Btn.astro";
import Head from "../components/Head.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Checks from "../components/Checks.astro";
import Chips from "../components/Chips.astro";
import Cta from "../components/Cta.astro";
import LogoBand from "../components/LogoBand.astro";
import { contact } from "../lib/contact";

const steps = [
  {
    step: "Share the need",
    bullets: ["Oracle module and role", "Experience level and project phase", "Start date, duration and location"],
  },
  {
    step: "Shortlist",
    bullets: ["Profiles from YECC’s trusted network of experienced Oracle Consultants", "Screened by YECC’s Oracle functional experts", "Only candidates who fit the role are shared"],
  },
  {
    step: "Interview",
    bullets: ["Your team interviews the shortlist", "Practical, process-led candidates", "Quick turnaround on feedback"],
  },
  {
    step: "Onboard",
    bullets: ["Resources join your project team", "YECC stays in touch through the engagement", "Upskilling support through YECC courses"],
  },
];

// Experienced consultants in YECC's network, by Oracle track.
const figures = [
  { value: "1,500+", label: "Financials (FIN)" },
  { value: "1,000+", label: "Supply Chain Management (SCM)" },
  { value: "1,000+", label: "Human Capital Management (HCM)" },
  { value: "300+", label: "Enterprise Performance Management (EPM)" },
  { value: "300+", label: "Projects Portfolio Management (PPM)" },
  { value: "1,500+", label: "Oracle Technical" },
];
---
<Layout
  path="/resource-augmentation"
  title="Oracle Resource Augmentation for SIs | YECC"
  description="Experienced Oracle consultants for System Integrators, from a trusted community of 5,000+ Oracle Consultants across tracks and modules, deployed quickly to fill delivery gaps."
>
  <Hero
    eyebrow="Oracle Resource Augmentation for SIs"
    title="Experienced Oracle talent,| when your projects need it."
    lead="Trusted community of 5,000+ Oracle Consultants across various tracks and modules."
  >
    <Btn href={contact("resources")}>Share a resource requirement</Btn>
    <Btn href="#how-it-works" ghost>See how it works</Btn>
  </Hero>

  <LogoBand label="YECC learners now work at" />

  <section class="figures figures-tracks" aria-labelledby="figures-cap">
    <div class="wrap">
      <p class="figures-cap" id="figures-cap">Experienced consultants in our network, by track</p>
      <dl>
        {figures.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <Section id="why">
    <Head
      eyebrow="Why SIs augment with YECC"
      title="Fill delivery gaps| without slowing the project."
      lead="Implementation and support projects need extra hands at short notice. YECC gives you consultants from the trusted network who can quickly adopt and contribute to your delivery projects."
    />
    <div class="grid c3">
      <Card icon="shield" title="Trusted Network" text="We provide consultants from our founding team’s trusted network, built over 15+ years in the Oracle ecosystem, not random profiles sourced from the open market." />
      <Card icon="clock" title="Quick Deployment" text="Thanks to standardised contracting processes and a flexible talent pool, resources can be deployed to your projects in no time." />
      <Card icon="refresh" title="Continuous Monitoring" text="We don’t just deploy the resources and step away. Through continuous engagement with your delivery leads and the augmented consultants, we act as your indirect project management team." />
    </div>
  </Section>

  <Section id="how-it-works">
    <Head
      eyebrow="How it works"
      title="From requirement to onboarding| in four steps."
    />
    <ol class="stages">
      {steps.map((s, i) => (
        <li>
          <h3><span>{String(i + 1).padStart(2, "0")}</span>{s.step}</h3>
          <Checks items={s.bullets} />
        </li>
      ))}
    </ol>
  </Section>

  <Section id="engagement" class="bg-navy">
    <Head
      eyebrow="Engagement models"
      title="Flexible terms| for every project."
      lead="Pricing and terms are agreed for each requirement, based on the role, the duration and the project."
    >
      <Chips items={["Project-based deployment", "Contract-to-hire", "Direct hiring of trained freshers", "Custom pricing"]} />
    </Head>
  </Section>

  <Cta eyebrow="Need Oracle consultants?" title="Tell us the module, the role and the start date, and we will share profiles.">
    <Btn href={contact("resources")}>Share a resource requirement</Btn>
  </Cta>
</Layout>
