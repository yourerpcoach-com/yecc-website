---
import { to } from "../lib/site";
// DaaS was renamed DOCaaS. This old address forwards to the new page (keeping any #section), so links
// shared before the rename keep working. It is left out of the sitemap and search results.
const target = to("/docaas");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to DOCaaS | YECC</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
  </head>
  <body>
    <p>This page has moved to <a href={target}>DOCaaS</a>.</p>
  </body>
</html>
