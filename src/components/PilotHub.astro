---
// Illustration for the SHERPA pilot: the pilot at the hub, with its three inclusions as equal spokes around it.
// They are three distinct parts of one offer, not steps, so nothing is numbered or ordered.
// Each spoke has a small drawing that matches its icon in the list beside it.
const nodes = [
  { x: 260, y: 92, label: "Up to 25 processes, free", labelY: 22, icon: "transform" },
  { x: 118, y: 320, label: "Redwood-ready", labelY: 404, icon: "redwood" },
  { x: 402, y: 320, label: "In-app delivery", labelY: 404, icon: "inapp" },
];
const ink = "#0d2344";
const soft = "#7189b0";
---
<svg class="pilot-hub" viewBox="0 0 520 430" fill="none" aria-hidden="true">
  <circle cx="260" cy="240" r="190" fill="#2b72d9" opacity=".1" />
  <circle cx="260" cy="240" r="150" stroke="#ffffff" stroke-opacity=".1" stroke-width="1" />

  {nodes.map((n) => <line x1="260" y1="240" x2={n.x} y2={n.y} stroke="#ffffff" stroke-opacity=".35" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="1 7" />)}

  <circle cx="260" cy="240" r="78" stroke="#2b72d9" stroke-opacity=".5" stroke-width="1" />
  <circle cx="260" cy="240" r="62" fill="#2b72d9" />
  <text x="260" y="238" text-anchor="middle" class="pilot-hub-name">SHERPA</text>
  <text x="260" y="260" text-anchor="middle" class="pilot-hub-sub">pilot</text>

  {nodes.map((n) => (
    <g transform={`translate(${n.x - 56} ${n.y - 56})`}>
      <rect width="112" height="112" rx="24" fill="#ffffff" />
      {n.icon === "transform" && (
        <g stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
          <rect x="22" y="36" width="28" height="38" rx="4" stroke={ink} />
          <path d="M29 47h14M29 54h14M29 61h8" stroke={soft} />
          <path d="M57 55h11m-4-4 4 4-4 4" stroke={soft} />
          <circle cx="84" cy="55" r="12" stroke="#e53935" />
          <path d="M81 50 89 55 81 60Z" fill="#e53935" stroke="none" />
        </g>
      )}
      {n.icon === "redwood" && (
        <g stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
          <rect x="22" y="31" width="68" height="50" rx="6" stroke={ink} />
          <path d="M22 42h68" stroke={ink} />
          <circle cx="29" cy="36.5" r="1.6" fill="#e53935" stroke="none" />
          <path d="M30 50v23" stroke={soft} />
          <path d="M40 51h40M40 59h28M40 66h34" stroke={soft} />
        </g>
      )}
      {n.icon === "inapp" && (
        <g stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6">
          <rect x="22" y="40" width="68" height="42" rx="5" stroke={ink} />
          <path d="M56 82v8M45 90h22" stroke={ink} />
          <path d="M31 62h20M31 70h30" stroke={soft} />
          {/* Speech bubble resting on the screen: its pointer tip touches the screen's top edge (y 40) and its
              right edge lines up with the screen's right edge (x 90). */}
          <path d="M57 17h28a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5h-5l-4 5-4-5H57a5 5 0 0 1-5-5v-8a5 5 0 0 1 5-5Z" stroke="#e53935" />
          <path d="M59 24h22M59 29h13" stroke="#e53935" />
        </g>
      )}
    </g>
  ))}

  {nodes.map((n) => <text x={n.x} y={n.labelY} text-anchor="middle" class="pilot-node-label">{n.label}</text>)}
</svg>
